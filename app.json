{
  "expo": {
    "name": "Tasks",
    "slug": "momentum-app",
    "version": "3.0.1",
    "orientation": "portrait",
    "scheme": "momentumtasks",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060807",
    "primaryColor": "#3DDC84",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060807"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.semyonsw.momentum.tasks",
      "versionCode": 78,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060807"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#3DDC84"
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ]
    ]
  }
}
